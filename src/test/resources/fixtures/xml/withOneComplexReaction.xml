<EnzymeMLDocument>
    <name>Example Document</name>
    <version>2.0</version>
    <vessels>
        <Vessel>
            <id>v-1</id>
            <name>vessel-1</name>
            <volume>1.1</volume>            
            <unit id="l" name="litre">              
                <base_units>                   
                    <BaseUnit kind="litre" exponent="1" multiplier="1.0" scale="0.0"/>
                </base_units>              
            </unit>             
            <constant>true</constant>                     
        </Vessel>
    </vessels>
    <proteins>
        <Protein>
            <id>p-1</id>
            <name>Protein-1</name>
            <constant>true</constant>          
        </Protein>
    </proteins>
    <small_molecules>
        <SmallMolecule>
            <id>sm-1</id>
            <name>small-molecule-1</name>
            <constant>false</constant>           
        </SmallMolecule>
        <SmallMolecule>
            <id>sm-2</id>
            <name>small-molecule-2</name>
            <constant>false</constant>             
        </SmallMolecule>
        <SmallMolecule>
            <id>sm-3</id>
            <name>small-molecule-3</name>
            <constant>true</constant>           
        </SmallMolecule>
    </small_molecules>
    <reactions>
        <Reaction>
            <id>r-1</id>
            <name>reaction-1</name>
            <reversible>true</reversible>
            <kinetic_law>
                <species_id>sm-1</species_id>
                <equation>a=b*c</equation>
                <equation_type>assignment</equation_type>
                <variables>
                    <Variable>
                        <id>v-1</id>
                        <name>variable-1</name>
                        <symbol>b</symbol>
                    </Variable>
                </variables>
            </kinetic_law>
            <reactants>
                <ReactionElement>
                    <species_id>sm-1</species_id>
                    <stoichiometry>-1.0</stoichiometry>
                </ReactionElement>
            </reactants>
            <products>
                <ReactionElement>
                    <species_id>sm-2</species_id>
                    <stoichiometry>1.0</stoichiometry>
                </ReactionElement>                
            </products>
            <modifiers>
                <ModifierElement>
                    <species_id>sm-3</species_id>
                    <role>buffer</role>
                </ModifierElement>
                <ModifierElement>
                    <species_id>p-1</species_id>
                    <role>biocatalyst</role>
                </ModifierElement>
            </modifiers>
        </Reaction>
    </reactions>
</EnzymeMLDocument>