<EnzymeMLDocument>
    <name>Example Document</name>
    <version>2.0</version>    
    <vessels>
        <Vessel>
            <id>v-1</id>
            <name>vessel-1</name>
            <volume>1.1</volume>            
            <unit id="l" name="litre">              
                <base_units>                   
                    <BaseUnit kind="litre" exponent="1" multiplier="1.0" scale="0.0"/>
                </base_units>              
            </unit>             
            <constant>true</constant>                                 
        </Vessel>
        <Vessel>
            <id>v-2</id>
            <name>vessel-2</name>
            <volume>100.0</volume>
            <unit id="ml" name="mililitre">              
                <base_units>                   
                    <BaseUnit kind="litre" exponent="1" multiplier="1.0" scale="-3.0"/>
                </base_units>              
            </unit>               
            <constant>true</constant>                               
        </Vessel>
    </vessels>
</EnzymeMLDocument>